# ===== 进销存服务配置 =====

# 监听地址与端口
BIND_ADDR=0.0.0.0:8080

# SQLite 数据库文件（相对路径基于进程工作目录）
DATABASE_URL=sqlite://data/jxc.db

# JWT 签名密钥 —— 生产环境必须改成随机长字符串！
# 生成方法：openssl rand -hex 32
JWT_SECRET=

# 登录有效期（小时），默认 30 天
JWT_TTL_HOURS=720

# 首次启动自动创建的管理员账号，之后可登录修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 日志级别：error | warn | info | debug
RUST_LOG=jinxiaocun=info,tower_http=warn